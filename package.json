{
  "name": "cloudflare-stealth",
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Workers proxy with HTTP/1.1 and HTTP/2 support",
  "main": "dist/fetch2.js",
  "types": "dist/fetch2.d.ts",
  "files": [
    "dist/**/*",
    "build/**/*"
  ],
  "scripts": {
    "build:rust": "cargo install -q worker-build --version 0.8.1 && worker-build --release",
    "build:dist": "node esbuild.config.js",
    "build": "npm run build:rust && npm run build:dist",
    "clean": "rm -rf dist",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "clippy:fix": "cargo clippy --fix --all-targets --all-features --allow-dirty",
    "lint": "npm run fmt:check && npm run clippy",
    "lint:fix": "npm run fmt && npm run clippy:fix",
    "test": "cargo test"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "proxy",
    "http",
    "rust",
    "typescript",
    "wasm"
  ],
  "author": "alpgul",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.0.0",
    "typescript": "^5.9.3",
    "esbuild": "^0.19.0"
  }
}
